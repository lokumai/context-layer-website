# Copy to .env (gitignored) for local Bun runs, or set via your hosting
# provider's secret manager in production.
#
# DigitalOcean App Platform: declare each variable in .do/app.yaml under the
# `mcp` service. CONTEXT_LAYER_TOKEN must be { scope: RUN_TIME, type: SECRET }.

# HTTP listen port. Default 8765. App Platform routes /mcp-api/* to this port.
PORT=8765

# Workspace identifier surfaced on /healthz; advisory in mock mode.
CONTEXT_LAYER_WORKSPACE=microservices-product-catalog

# Bearer token required on every /mcp request.
# Generate with: `openssl rand -hex 32`. When unset, the server accepts every
# request — DO NOT leave unset in production.
CONTEXT_LAYER_TOKEN=
