# Copy to .env.local (which is gitignored) and fill in real values.
# In production, set these via your hosting provider's secret manager.
#
# DigitalOcean App Platform: declare each variable in .do/app.yaml as
#   { scope: RUN_TIME, type: SECRET } and inject the value via `doctl apps update`
#   or the App Platform UI's Settings → Components → web → Environment Variables.
#
# AUTH_SECRET must be set in production. Generate with: `openssl rand -base64 32`.
# In development the Auth.js dev fallback accepts any non-empty value.
AUTH_SECRET=

# Passwords for each demo persona. Required in production.
# In development, missing values fall back to a predictable dev default with a
# startup warning (see src/lib/personas.ts).
AUTH_EMPTY_PASSWORD=
AUTH_PARTIAL_PASSWORD=
AUTH_FULL_PASSWORD=
